<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>StrangerChat — Talk to Random People</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="home-body">

  <div class="home-wrap">

    <header class="home-header">
      <div class="home-brand">🎲 StrangerChat</div>
    </header>

    <section class="home-hero">
      <h1 class="home-title">Talk to <span class="home-title-accent">Strangers</span></h1>
      <p class="home-sub">Anonymous · Instant · Free — no account needed</p>
    </section>

    <!-- Interest input -->
    <div class="interest-wrap">
      <label class="interest-label">
        🏷️ Add your interests <span class="interest-optional">(optional, up to 5)</span>
      </label>
      <div class="tag-input-row">
        <input
          id="tagInput"
          class="interest-input"
          type="text"
          placeholder="Type a tag…"
          maxlength="30"
          autocomplete="off"
        />
        <button class="btn-tag-add" id="tagAddBtn">Add</button>
      </div>
      <p class="interest-hint">Press Enter or click Add · We'll match you with someone who shares them</p>
      <div class="tag-chips" id="tagChips"></div>
    </div>

    <!-- Mode cards -->
    <div class="mode-grid">
      <button class="mode-card mode-card--text" onclick="startChat('text')">
        <div class="mode-icon">💬</div>
        <div class="mode-info">
          <h2 class="mode-title">Text Chat</h2>
          <p class="mode-desc">Chat anonymously using just text. No camera needed.</p>
          <div class="mode-badges">
            <span class="badge">No camera</span>
            <span class="badge">Fast</span>
          </div>
        </div>
        <div class="mode-arrow">→</div>
      </button>

      <button class="mode-card mode-card--video" onclick="startChat('video')">
        <div class="mode-icon">📹</div>
        <div class="mode-info">
          <h2 class="mode-title">Video Chat</h2>
          <p class="mode-desc">Go face to face over live video + text chat.</p>
          <div class="mode-badges">
            <span class="badge">Camera + mic</span>
            <span class="badge">P2P</span>
          </div>
        </div>
        <div class="mode-arrow">→</div>
      </button>
    </div>

    <footer class="home-footer">
      <span>🔒 Peer-to-peer video</span>
      <span class="home-footer-sep">·</span>
      <span>🚫 No sign up</span>
      <span class="home-footer-sep">·</span>
      <span>⚡ Connect instantly</span>
    </footer>

  </div>

  <script>
    const tagInput = document.getElementById('tagInput');
    const tagAddBtn = document.getElementById('tagAddBtn');
    const chipsEl = document.getElementById('tagChips');
    let tags = [];

    // Pre-fill tags if returning from "Change Tags"
    const prefilled = new URLSearchParams(window.location.search).get('interests');
    if (prefilled) {
      tags = prefilled.split(',').map(s => s.trim()).filter(Boolean).slice(0, 5);
      renderChips();
    }

    function renderChips() {
      chipsEl.innerHTML = tags.map((t, i) =>
        `<span class="tag-chip">${t}<button class="tag-chip-remove" onclick="removeTag(${i})" title="Remove">×</button></span>`
      ).join('');
    }

    function addTag() {
      const val = tagInput.value.trim().toLowerCase().replace(/[^a-z0-9 _-]/g, '');
      if (!val || tags.includes(val) || tags.length >= 5) {
        tagInput.value = '';
        return;
      }
      tags.push(val);
      tagInput.value = '';
      renderChips();
    }

    function removeTag(i) {
      tags.splice(i, 1);
      renderChips();
    }

    tagAddBtn.addEventListener('click', addTag);
    tagInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') { e.preventDefault(); addTag(); }
    });

    function startChat(mode) {
      const params = new URLSearchParams({ mode });
      if (tags.length) params.set('interests', tags.join(','));
      window.location.href = '/chat?' + params.toString();
    }
  </script>
</body>
</html>
