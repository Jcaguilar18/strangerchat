<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>StrangerChat — Talk to Random People</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="home-body">

  <div class="home-wrap">

    <!-- Header -->
    <header class="home-header">
      <div class="home-brand">
        <span class="home-brand-icon">🎲</span>
        StrangerChat
      </div>
    </header>

    <!-- Hero -->
    <section class="home-hero">
      <h1 class="home-title">Talk to <span class="home-title-accent">Strangers</span></h1>
      <p class="home-sub">Anonymous, instant, free — no account needed.</p>
    </section>

    <!-- Mode picker -->
    <section class="mode-grid">

      <a href="/chat?mode=text" class="mode-card mode-card--text">
        <div class="mode-icon">💬</div>
        <h2 class="mode-title">Text Chat</h2>
        <p class="mode-desc">Chat anonymously with a random stranger using just text. Fast and private.</p>
        <div class="mode-badges">
          <span class="badge">No camera needed</span>
          <span class="badge">Instant</span>
        </div>
        <div class="mode-btn mode-btn--text">Start Text Chat →</div>
      </a>

      <a href="/chat?mode=video" class="mode-card mode-card--video">
        <div class="mode-icon">📹</div>
        <h2 class="mode-title">Video Chat</h2>
        <p class="mode-desc">Go face to face with a random stranger over live video and chat.</p>
        <div class="mode-badges">
          <span class="badge">Camera + mic</span>
          <span class="badge">Peer-to-peer</span>
        </div>
        <div class="mode-btn mode-btn--video">Start Video Chat →</div>
      </a>

    </section>

    <!-- Footer note -->
    <footer class="home-footer">
      <span>🔒 Peer-to-peer video — we never see your camera</span>
      <span class="home-footer-sep">·</span>
      <span>🚫 No sign up required</span>
      <span class="home-footer-sep">·</span>
      <span>⚡ Connect instantly</span>
    </footer>

  </div>

</body>
</html>
